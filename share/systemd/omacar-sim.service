[Unit]
Description=OmaCar simulator — a 2015 CR-Z in software, no adapter needed
Documentation=file:__ROOT__/README.md
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# The system python is enough: sim.py generates data, it does not import obd
# and never opens the serial port.
ExecStart=/bin/sh -c '. __ROOT__/lib/env.sh; exec "$OMACAR_PY" __ROOT__/lib/sim.py run'
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
